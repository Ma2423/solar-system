<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "https://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D version="3.3" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance">
  <Scene>
    <!-- Earth -->
    <Shape>
      <Appearance>
        <Material diffuseColor="0.2 0.5 0.9"/>
        <ImageTexture url="images/earth.jpg"/>
      </Appearance>
      <Sphere radius="0.6"/>
    </Shape>
    <!-- Moon -->
    <Transform translation="1.1 0 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.8 0.8 0.8"/>
          <ImageTexture url="images/moon.jpg"/>
        </Appearance>
        <Sphere radius="0.16"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
